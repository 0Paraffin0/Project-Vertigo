{
  "expo": {
    "name": "LexStar",
    "slug": "lexstar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "lexstar",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexstar.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.lexstar.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "newsApiKey": "29c52b6d7c704430948faa03c138fcc5",
      "anthropicApiKey": "your_anthropic_key_here"
    }
  }
}
